{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // The cnpg preset looks every vchord pin up as `vchord-scratch`.
      description: "vchord Database pins follow the home-operations/vchord image",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tensorchord/vchord-scratch"],
      matchCurrentValue: "/^\\d+\\.\\d+\\.\\d+$/",
      overrideDepName: "ghcr.io/home-operations/vchord",
      overridePackageName: "ghcr.io/home-operations/vchord",
      extractVersion: "^(?<version>\\d+\\.\\d+\\.\\d+)$",
      versioning: "semver",
    },
    {
      // Also matches the pin: the rule above has renamed it.
      description: "Move the vchord image and its Database pin together",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/vchord"],
      groupName: "vchord",
    },
  ],
}
