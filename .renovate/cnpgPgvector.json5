{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      // Tracks `Database.spec.extensions[].version` for pgvector so it bumps alongside the
      // pgvector extension image — CNPG only runs `ALTER EXTENSION ... UPDATE` when this pin
      // moves. Modelled on the vchord manager in home-operations/renovate-presets
      // `apps/cnpg.json5`, which this repo extends: that one hardcodes the vchord depName, so
      // the pgvector pin needs its own manager here rather than a variant of it.
      //
      // Two match strings cover either field order (name-then-version and version-then-name);
      // each skips continuation lines, comments and blank lines, but never a new `- ` item, so
      // a sibling extension's version is never mis-attributed. No lookahead, so RE2 compiles both.
      description: "Detect CNPG Database CRD pgvector extension version pin",
      customType: "regex",
      managerFilePatterns: ["/.+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "name:\\s+vector\\b(?:\\n[ \\t]*|\\n +[^-\\s][^\\n]*)*?\\n +version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?",
        "version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?(?:\\n[ \\t]*|\\n +[^-\\s][^\\n]*)*?\\n +name:\\s+vector\\b",
      ],
      depNameTemplate: "ghcr.io/cloudnative-pg/pgvector",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // A pgvector tag is `<extension>-<pgmajor>-<debian>`, such as `0.8.7-18-trixie`. Read as
      // plain semver, `0.8.8-18-trixie`, `0.8.8-18-bookworm` and `0.8.8-19-trixie` are the same
      // version, and Renovate may offer a build for another PostgreSQL major or another Debian
      // base. Mapping PostgreSQL to `major`, the extension to `minor.patch.build` and the Debian
      // base to `compatibility` separates them: a `-19-` build is a major update while a new
      // extension build on 18 is not, and a release whose `compatibility` differs from the
      // current one is filtered out, so `bookworm` is never proposed for a trixie cluster.
      //
      // `matchCurrentValue` scopes this to the image tags; the Database pin below carries no
      // PostgreSQL major and has a rule of its own.
      description: "pgvector images carry a `-<pgmajor>-<debian>` suffix",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/pgvector"],
      matchCurrentValue: "/-\\d+-(?:trixie|bookworm)$/",
      versioning: "regex:^(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-(?<major>\\d+)-(?<compatibility>trixie|bookworm)$",
    },
    {
      // The Database pin is the bare extension version (`0.8.7`), so it cannot carry the
      // PostgreSQL major and the rule above does not parse it. `extractVersion` keeps only the
      // `-18-trixie` builds and strips that suffix, leaving the extension version, which plain
      // semver then reads: the pin resolves to the release the image ships, writes `0.8.8` rather
      // than a tag, and never picks up a `bookworm` build or a build for another major.
      //
      // The major is pinned deliberately. Accepting `-\d+-trixie` would let a release published
      // only for PostgreSQL 19 bump this pin while the 18 image stayed behind, leaving the
      // Database asking for an extension version its image does not ship. When the cluster's
      // PostgreSQL major moves, this `18` moves to `19` — and the pin with it — in the same change
      // as the major upgrade, which is why the major upgrade is one grouped pull request and not
      // an image-only bump.
      // `matchCurrentValue` keeps this rule to the pin, because the image tags start with a digit
      // too.
      description: "pgvector Database pins carry the bare extension version",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/pgvector"],
      matchCurrentValue: "/^\\d+\\.\\d+\\.\\d+$/",
      extractVersion: "^(?<version>\\d+\\.\\d+\\.\\d+)-18-trixie$",
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      // The two versionings above produce different branch topics, so `groupName` is what keeps
      // the image and its pin in one pull request: CNPG would refuse to install an extension the
      // image no longer carries if they moved apart. `.renovate/groups.json5` is applied after
      // this file and regroups a PostgreSQL major onto the cluster upgrade.
      description: "Move the pgvector image and its Database pin together",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/pgvector"],
      groupName: "pgvector",
    },
  ],
}
