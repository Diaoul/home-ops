{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/gha-runner-scale-set-controller/",
        "/gha-runner-scale-set/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Dragonfly Operator Group",
      groupName: "dragonfly-operator",
      matchPackagePatterns: ["dragonfly(?:db)?.operator"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Firecrawl Group",
      // nuq-postgres carries the queue schema the api expects; they ship together.
      groupName: "firecrawl",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^ghcr\\.io\\/firecrawl\\//"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Kanidm Group",
      groupName: "kanidm",
      matchDatasources: ["docker"],
      matchPackageNames: ["kanidm/server", "kanidm/tools"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchDatasources: ["custom.talos-factory", "github-releases", "github-tags"],
      matchPackageNames: ["/siderolabs\\/talos/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // A PostgreSQL major is a cluster upgrade, not an extension release: the base image and
      // its extension images have to move together, and a wrong one leaves a cluster that will
      // not start. Never automerge it. An extension release on the current major is not a major
      // update, so it stays in its own pull request.
      description: "Postgres major upgrade for the clusters with extension images",
      groupName: "postgresql-extensions-major",
      matchFileNames: [
        "kubernetes/apps/database/cloudnative-pg/cluster/cluster-hindsight.yaml",
        "kubernetes/apps/database/cloudnative-pg/cluster/cluster-immich.yaml",
      ],
      matchDatasources: ["docker"],
      matchUpdateTypes: ["major"],
      automerge: false,
      // Gives the extension images time to publish builds for the new major, so the PR has them all.
      minimumReleaseAge: "14 days",
    },
  ],
}
